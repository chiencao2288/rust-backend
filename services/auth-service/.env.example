# ==============================================================================
# AUTH SERVICE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server HTTP Port (Default: 8080)
PORT=8080

# PostgreSQL Configuration
# REQUIRED: Primary master URL for writes & transactions.
DATABASE_MASTER_URL="postgres://postgres:postgres@127.0.0.1:5432/auth_db"
# OPTIONAL: Comma-separated read replica (slave) URLs for round-robin SELECT queries.
DATABASE_SLAVE_URLS=""

# Redis Configuration
# REQUIRED: Comma-separated node URLs (cluster-native).
REDIS_NODES="redis://127.0.0.1:6379"
# OPTIONAL: Cluster authentication password.
REDIS_PASSWORD=""

# Token & Session TTL Policies
SESSION_TTL_SECS=1800
REFRESH_TOKEN_TTL_DAYS=30

# Third-party OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
