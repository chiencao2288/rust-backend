# ==============================================================================
# AUTH SERVICE ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server HTTP Port (Default: 8080)
PORT=8080

# Environment mode: "development" or "production"
# In development, failing responses attach sanitized request debug metadata envelopes.
APP_ENV="development"

# Logging configuration
# Format: "text" (human-readable for dev) or "json" (structured for log aggregation)
LOG_FORMAT="text"
RUST_LOG="info,auth_service=debug"

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
# REQUIRED: Primary master URL for mutations and transactions.
DATABASE_MASTER_URL="postgres://postgres:postgres@127.0.0.1:5432/auth_db"

# OPTIONAL: Read replica (slave) URL for read queries. If omitted, master handles reads.
DATABASE_SLAVE_URL_01=""

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# REQUIRED: Primary Redis node URL (cluster-native).
REDIS_NODE_01="redis://127.0.0.1:6379"

# OPTIONAL: Redis authentication password.
REDIS_PASSWORD=""
# ------------------------------------------------------------------------------
# RabbitMQ Configuration
# ------------------------------------------------------------------------------
# REQUIRED: AMQP broker connection URL for publishing notification events.
RABBITMQ_URL="amqp://guest:guest@127.0.0.1:5672/%2f"

# Token & Session TTL Policies
# ------------------------------------------------------------------------------
# Access token session lifetime in seconds (Default: 1800 = 30 minutes)
SESSION_TTL_SEC=1800

# Refresh token expiration period in days (Default: 30 days)
REFRESH_TOKEN_TTL_DAY=30

# ------------------------------------------------------------------------------
# Third-party OAuth Providers (Optional)
# ------------------------------------------------------------------------------
# Optional OAuth client audience used to enforce Google token verification
GOOGLE_CLIENT_ID=""

# Google OAuth2 token verification endpoint (Default: https://oauth2.googleapis.com/tokeninfo)
GOOGLE_OAUTH_URL="https://oauth2.googleapis.com/tokeninfo"
