# ==============================================================================
# NOTIFICATION SERVICE ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Server HTTP Port (Default: 8081)
PORT=8081

# Environment mode: "development" or "production"
APP_ENV="development"

# Logging configuration
LOG_FORMAT="text"
RUST_LOG="info,noti_service=debug"

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
# REQUIRED: Primary master URL for writes & transactions.
DATABASE_MASTER_URL="postgres://postgres:postgres@127.0.0.1:5432/noti_db"

# OPTIONAL: Read replica (slave) URL for read queries.
DATABASE_SLAVE_URL_01=""

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# REQUIRED: Primary Redis node URL.
REDIS_NODE_01="redis://127.0.0.1:6379"

# OPTIONAL: Redis authentication password.
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# RabbitMQ Configuration
# ------------------------------------------------------------------------------
# REQUIRED: AMQP broker connection URL.
RABBITMQ_URL="amqp://guest:guest@127.0.0.1:5672/%2f"

# ------------------------------------------------------------------------------
# Auth Service Inter-Service Verification
# ------------------------------------------------------------------------------
# URL of auth-service for validating client Bearer tokens.
AUTH_SERVICE_URL="http://127.0.0.1:8080"

# ------------------------------------------------------------------------------
# Email Delivery Provider Configuration
# ------------------------------------------------------------------------------
# Provider mode: "mock" (logs sent email in console for dev) or "smtp" (actual SMTP)
EMAIL_PROVIDER="smtp"

# Mail Settings (Required when EMAIL_PROVIDER=smtp)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-app-password"
MAIL_FROM="your-email@gmail.com"
MAIL_FROM_NAME="Podkeen"
# ------------------------------------------------------------------------------
# SMS Delivery Provider Configuration
# ------------------------------------------------------------------------------
# Provider mode: "mock" (logs SMS to console for dev)
SMS_PROVIDER="mock"
